# --- AgentOps Cockpit environment ---
# No LLM API keys anywhere: the model is self-hosted on Ollama.
# Copy to `.env` and tweak only if your endpoints differ.

# ---- Real LLM (Ollama) ----
# Start with: `ollama serve` then `ollama pull llama3.2:1b` (+ `nomic-embed-text`).
OLLAMA_URL=http://localhost:11434
AGENTOPS_MODEL=llama3.2:1b          # chat model for plan + synthesise steps
AGENTOPS_BIG_MODEL=llama3.2:3b      # heavier model used by the latency scenario

# ---- Real SigNoz backend (OTLP export) ----
# Bring up SigNoz via Foundry (see deploy/signoz/README.md). OTLP defaults:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # OTLP/HTTP into SigNoz
OTEL_SERVICE_NAME=agentops-demo-agent
DEPLOYMENT_ENVIRONMENT=hackathon
SIGNOZ_URL=http://localhost:8080                     # SigNoz UI (health + deep-links)

# ---- Local ----
AGENTOPS_LEDGER=./data/ledger.jsonl                  # local mirror of exported spans
